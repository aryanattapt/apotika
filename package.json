{
  "name": "apotek-digital",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "test:api": "bun run --cwd apps/api test",
    "build:api": "bun run --cwd apps/api build",
    "db:migrate": "bun run --cwd apps/api migrate",
    "db:seed": "bun run --cwd apps/api seed",
    "provision:user": "bun run --cwd apps/api provision:user"
  }
}
