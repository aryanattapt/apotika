{
  "name": "@apotek/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file ../../.env --watch src/server.ts",
    "start": "bun --env-file ../../.env src/server.ts",
    "migrate": "bun --env-file ../../.env src/interfaces/cli/migrate.ts",
    "seed": "bun --env-file ../../.env src/interfaces/cli/seed.ts",
    "provision:user": "bun --env-file ../../.env src/interfaces/cli/provision-user.ts",
    "test": "bun test src",
    "build": "bun build src/server.ts --target=bun --outdir=dist"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.5"
  }
}
